# Copy to .env and fill in. All are optional — matching CLI flags override
# these, and hardcoded defaults (or "disabled") apply if neither is set.
RETRACER_DATABASE_URL=postgres://retracer:retracer@localhost:5433/retracer
# This chain's node HTTP RPC — blocks are read from it.
RETRACER_NODE_RPC_URL=http://127.0.0.1:8081
# Optional bearer token sent only to the node RPC above. Prefer setting this in
# the environment rather than a CLI flag so it is not exposed in process args.
RETRACER_NODE_RPC_TOKEN=
# Shared inbound secret for Authorization: Bearer on both surfaces. Leave unset to
# keep today's trusted-consumer behavior (both surfaces open).
RETRACER_AUTH_TOKEN=
# Per-IP requests/second on both surfaces. Leave unset to disable.
RETRACER_RATE_LIMIT_RPS=
# Proxies whose X-Forwarded-For the limiter may believe (comma-separated
# IPs/CIDRs). Leave unset so the socket peer is always the client.
RETRACER_TRUSTED_PROXIES=
# Interface each API surface listens on. Leave unset for 127.0.0.1 (loopback
# only). Setting either to 0.0.0.0 exposes that surface on every interface —
# only do this behind a firewall, a private network, or with
# RETRACER_AUTH_TOKEN set; both surfaces are plaintext.
RETRACER_GRPC_BIND=
RETRACER_REST_BIND=
